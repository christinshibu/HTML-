{
  "extends": [
    "development"
  ],
  "hints": {
    "axe/forms": "off",
    "compat-api/html": "off",
    "button-type": "off",
    "meta-viewport": "off",
    "axe/name-role-value": [
      "default",
      {
        "link-name": "off",
        "button-name": "off"
      }
    ],
    "no-inline-styles": "off",
    "axe/structure": [
      "default",
      {
        "list": "off",
        "definition-list": "off",
        "dlitem": "off",
        "listitem": "off"
      }
    ],
    "axe/text-alternatives": [
      "default",
      {
        "frame-title": "off"
      }
    ],
    "axe/language": [
      "default",
      {
        "html-has-lang": "off"
      }
    ],
    "meta-charset-utf-8": "off",
    "axe/aria": [
      "default",
      {
        "empty-table-header": "off"
      }
    ]
  }
}